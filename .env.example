# API Keys для Promo/Abuse Providers
# Скопируй этот файл в .env и заполни значения
# cp .env.example .env
#
# ВАЖНО: .env добавлен в .gitignore и НЕ должен коммититься!
#
# Как получить ключи: см. 01-Reference/abuse-providers-inbox.md

# AnyModel (5M токенов за Telegram)
# Регистрация: https://anymodel.org/?ref=WS2RUV7
# Endpoint: https://anymodel.org/v1
ANYMODEL_API_KEY=

# ai.hdd.sb (бесплатный Grok relay)
# Регистрация: https://ai.hdd.sb/
# Endpoint: https://ai.hdd.sb/v1
HDD_SB_API_KEY=

# AMD Radeon Cloud Token Factory (официальный бесплатный API)
# Регистрация: https://developer.amd.com.cn/radeon/modelapis
# Endpoint: https://developer.amd.com.cn/radeon/api/v1
AMD_RADEON_API_KEY=

# EIRouter (дешёвые флагманы: GPT-6 Astra $1/1M)
# Регистрация: https://eirouter.ai/register?aff=2BDEFAHA
# Endpoint: https://eirouter.ai/v1
EIROUTER_API_KEY=

# TokenBom (биржа провайдеров, бесконечный баланс через рефералов)
# Регистрация: https://tokenbom.com/login?mode=register&invite=SS-A938F0A7
# Endpoint: зависит от выбранного провайдера
TOKENBOM_API_KEY=

# TabiToken (раздача ключей по $120)
# Сайт: https://tabitoken.com
# Endpoint: https://tabitoken.com/v1
TABITOKEN_API_KEY=

# DeepSeek bloodthemes (безлимитный DeepSeek)
# Сайт: https://deepseek.bloodthemes.ru/
# Endpoint: https://deepseek.bloodthemes.ru/v1
DEEPSEEK_BLOODTHEMES_API_KEY=

# freeai.up.railway.app ($10,000 для Claude Opus 5)
# Endpoint: https://freeai.up.railway.app/v1
FREEAI_RAILWAY_API_KEY=

# nova.vcrauo.com (новый шлюз, нужен GitHub 1+ год)
# Сайт: https://nova.vcrauo.com/sign-up?aff=EGDM
NOVA_VCRAUO_API_KEY=

# ai.furry.vg (GPT-6 Astra, Claude Fable 5)
# Сайт: https://ai.furry.vg/sign-up?aff=8RCAJZ7B
AI_FURRY_VG_API_KEY=

# htai91.com ($50 на баланс, поштучная тарификация)
# Сайт: https://htai91.com/sign-up?aff=dt2C
HTAI91_API_KEY=

# tokenin.my.id (FREE модели: Kimi K3, DeepSeek V4 Pro, GPT 5.6 Sol)
# Сайт: https://tokenin.my.id/
# Referral: A8E44FFB43
TOKENIN_MY_ID_API_KEY=

# === Существующие провайдеры (уже подключены) ===

# LinaliAPI (подключён 2026-09-06)
# Регистрация: https://linaliapi.com/dashboard/register
# Endpoint: https://api.linaliapi.com/v1
# Ключ уже в ~/.local/share/opencode/auth.json (ID: linaliapi)
LINALIAPI_API_KEY=

# JustDoWork/justwoker ( BLOCKED: нет моделей)
# Регистрация: https://api.justwoker.icu
# Endpoint: https://api.justwoker.icu/v1
# Ключ уже в ~/.local/share/opencode/auth.json (ID: justwoker)
JUSTWOKER_API_KEY=
