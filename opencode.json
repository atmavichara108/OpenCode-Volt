{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "librarian",
  "lsp": true,
  "model": "opencode-go/glm-5.3-flash",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": {
      "*": "deny",
      "/home/rudra/Projects/OpenCode-Vault/**": "allow",
      "/home/rudra/Projects/serp/**": "allow",
      "/home/rudra/dotfiles/**": "allow",
      "/home/rudra/.config/opencode/**": "allow",
      "/home/rudra/.local/share/m-code-data/**": "allow",
      "/home/rudra/.local/share/opencode/auth.json": "allow",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "systemctl stop*": "deny",
      "systemctl disable*": "deny",
      "systemctl mask*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D*": "deny",
      "git tag -d*": "deny",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm*": "ask",
      "ssh*": "ask"
    }
  },
  "agent": {
    "general": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    }
  }
}
