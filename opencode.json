{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "librarian",
  "lsp": true,
  "model": "opencode-go/glm-5.3-flash",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": {
      "*": "deny",
      "/home/rudra/Projects/OpenCode-Vault/**": "allow",
      "/home/rudra/Projects/serp/**": "allow",
      "/home/rudra/dotfiles/**": "allow",
      "/home/rudra/.config/opencode/**": "allow",
      "/home/rudra/.local/share/m-code-data/**": "allow",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "systemctl stop*": "deny",
      "systemctl disable*": "deny",
      "systemctl mask*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D*": "deny",
      "git tag -d*": "deny",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm*": "ask",
      "ssh*": "ask"
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/rudra/Projects/OpenCode-Vault/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/rudra/Projects/serp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/rudra/dotfiles/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/rudra/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/rudra/.local/share/m-code-data/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/.env*", "effect": "deny" },
    { "action": "external_directory", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "external_directory", "resource": "**/*.pem", "effect": "deny" },
    { "action": "external_directory", "resource": "**/*.key", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl stop*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl disable*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl mask*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr*", "effect": "deny" },
    { "action": "shell", "resource": "rm*", "effect": "ask" },
    { "action": "shell", "resource": "ssh*", "effect": "ask" }
  ],
  "agent": {
    "general": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    }
  },
  "agents": {
    "general": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    }
  }
}
