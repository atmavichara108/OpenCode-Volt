# Скопируй в .env и заполни:  cp .env.example .env
# .env в gitignore — credentials в репозиторий не попадают.

# IMAP Gmail (нужен включённый IMAP в настройках + app password при включённой 2FA)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=

# Папки по умолчанию через запятую (обход всех — флаг --all)
FOLDERS=INBOX

# Служебный state-файл (processed ids); относительный путь — от tools/email-capture/
STATE_PATH=.state/processed.jsonl

# Дефолтное ограничение числа писем на прогон (общий бюджет)
DEFAULT_LIMIT=50

# Куда дописывать интенты (обычно менять не нужно — дефолт = 04-Memory/idea-graph)
# GRAPH_DIR=../04-Memory/idea-graph
# NODES_PATH=
# EDGES_PATH=
# VALIDATOR_PATH=
# EMAIL_SOURCE_NODE=world-source-email-gmail

# Необязательно: переопределение контрольных фраз по интенту (CSV, lowercase).
# Без этого значения работают дефолты из config.py.
# PHRASES_RESEARCH=обзор,benchmark,landscape
# PHRASES_IMPLEMENTATION=внедрение,roadmap,спека
# PHRASES_CORRECTION=вердикт,ратифицировать,revert
# PHRASES_PROJECTS=vibeos,opencode,dotfiles
# PHRASES_SUBSCRIPTIONS=newsletter,digest,рассылка
# PHRASES_ERROR=unsubscribe,спам,no-reply
